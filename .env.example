# Copy this file to .env.local and fill in real values.
# This is a Vite project, so client-exposed env vars must be prefixed with
# VITE_ (Vite does not read NEXT_PUBLIC_ - that's a Next.js-only convention).

# From Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The email of the single admin user you create in
# Supabase Dashboard -> Authentication -> Users -> Add User.
# The existing login screen only asks for a password; this email is used
# internally to complete the Supabase Auth sign-in. It is not a secret -
# the password (set when you create the user) is the real credential.
VITE_ADMIN_EMAIL=admin@yourdomain.com
